{
  "vscode_custom_css.imports": [
    "file://Users/caitlin/Documents/css/vscode/vscode.css"
  ],
  "editor.formatOnType": false,
  "editor.formatOnPaste": true,
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file",
  "files.autoSave": "onFocusChange",
/*   "[vue]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  }, */

  // enable ESLint to validate Vue files
  "eslint.validate": [ "vue"],

  // enable ESLint to fix tailwind classes on save
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "typescript.tsdk": "node_modules/typescript/lib",
  "exportall.config.folderListener": [
    "/app/components/tiptap",
    "/app/composables",
    "/app/utils",
    "/app/layouts/components",
    "/shared/indexes",
    "/shared/schema"
  ],
  "exportall.config.relExclusion": [
    "/app/utils/config",
    "/shared/data/records",
    "/shared/data/records/champions",
    "/shared/data/records/items",
    "/shared/data/records/runes",
    "/shared/records"
  ]
}
