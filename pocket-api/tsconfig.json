{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "types": ["node"],
    "paths": {
      "~/lolpocket/*": ["../lolpocket/*"],
      "~/shared/*": ["../lolpocket/shared/*"],
      "~/layers/*": ["../layers/*"]
    }
  },
  "include": [
    "./**/*.ts",
    "./**/*.d.ts",
    "../shared/schema/**/*.ts",
    "../shared/schema/**/*.d.ts",
    "../shared/types/**/*.ts",
    "../shared/types/**/*.d.ts"
  ],
  "exclude": ["../node_modules", "../.nuxt", "../dist"]
}
