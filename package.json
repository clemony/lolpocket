{
  "name": "lolpocket",
  "type": "module",
  "private": true,
  "scripts": {
    "⚡️ dev": "nuxt dev",
    "🍑 typecheck": "pnpm exec nuxt typecheck",
    "✨ lint:fix": "eslint . --fix",
    "🖍️ lint": "eslint .",
    "☔️ clean": "rm -rf node_modules  .nuxt .output pnpm-lock.yaml --force ",
    "🔥 nuxt:cleanup": "pnpm exec nuxt cleanup",
    "🍓 install": "pnpm install",
    "💅 prepare": "pnpm exec nuxt prepare",
    "eslint:config": "pnpm exec eslint-config-inspector",
    "🆘 eslint:debug": "pnpm eslint --debug eslint.config.mjs",
    "fix:unused-imports": "eslint --fix --rule '{\"unused-imports/no-unused-imports\":\"error\",\"unused-imports/no-unused-vars\":\"off\"}'",
    "sort:vscode-settings": "pnpm exec eslint --fix --no-ignore .vscode/settings.json && pnpm exec prettier --write .vscode/settings.json",
    "build": "nuxt build",
    "nuxt:upgrade": "rm -rf node_modules .nuxt .output pnpm-lock.yaml && pnpm install && pnpm up nuxt @nuxt/kit --latest && pnpm exec nuxi prepare",
    "debug": "DEBUG=vite:* pnpm exec nuxt dev",
    "generate": "nuxt generate",
    "pages:build": "pnpm exec nuxi build --preset=cloudflare_pages",
    "pages:deploy": "pnpm exec wrangler pages deploy dist",
    "preview": "nuxt preview",
    "deploy": "pnpm exec wrangler deploy"
  },
